{
  "name": "ec1-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:staging": "npm run check && wrangler deploy --env staging",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.13",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/node": "24.19.1",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.149.0"
  }
}
