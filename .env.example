# Copy to .dev.vars. Do not use these placeholders in a deployment.
PLAYER_TOKEN_SECRET=generate-a-distinct-random-secret
ADMIN_SESSION_SECRET=generate-a-second-distinct-random-secret
ALLOW_NEW_ACCOUNTS=true
LEGACY_MIGRATION_ENABLED=false
ENVIRONMENT=local
RECOVERY_ENABLED=false
IAP_PURCHASES_ENABLED=false
IAP_ALLOW_TEST_PURCHASES=false
IAP_GOOGLE_PUBLIC_KEY=
IAP_GOOGLE_SERVICE_ACCOUNT=
IAP_GOOGLE_PACKAGE_NAME=com.gacogames.epiccon
IAP_APPLE_BUNDLE_ID=com.gacogames.epiccon
IAP_APPLE_VERIFICATION_MODE=receipt
MAIL_FROM=noreply@gacogames.com
PASSWORD_RESET_ORIGIN=https://ec1.gacogames.com
# Start the EC2 Worker locally too for the ADMIN_AUTHORITY service binding.
# Discord admin app credentials belong to EC2's private AdminAuthority.
DISCORD_ADMIN_REDIRECT_URI=http://127.0.0.1:8791/auth/discord/callback
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
DISCORD_GAME_CLIENT_ID=
DISCORD_GAME_CLIENT_SECRET=
DISCORD_GAME_REDIRECT_URIS=
# Legacy source credentials are unnecessary for new account/save tests.
PLAYFAB_TITLE_ID=3BFE7
PLAYFAB_SECRET_KEY=
